{
  "schemaVersion": 1,
  "id": "motion-blur",
  "name": "Motion Blur",
  "type": "post_process",
  "inputs": ["scene_depth", "scene_velocity"],
  "parameters": [
    { "id": "directional_blur_strength", "name": "Directional Blur Strength", "slot": 0, "default": 1.2, "min": 0.0, "max": 3.0 },
    { "id": "line_blur_length", "name": "Line Blur Length", "slot": 1, "default": 2.5, "min": 0.0, "max": 10.0 },
    { "id": "line_blur_strength", "name": "Line Blur Strength", "slot": 2, "default": 1.5, "min": 0.0, "max": 10.0 },
    { "id": "velocity_limit", "name": "Velocity Limit", "slot": 3, "default": 0.2, "min": 0.0, "max": 3.0 },
    { "id": "velocity_under_cut", "name": "Velocity Under Cut", "slot": 4, "default": 0.006, "min": 0.0, "max": 3.0 },
    { "id": "scene_change_position_threshold", "name": "Scene Change Position Threshold", "slot": 5, "default": 20.0, "min": 0.0, "max": 100.0 },
    { "id": "scene_change_angle_threshold", "name": "Scene Change Angle Threshold", "slot": 6, "default": 25.0, "min": 0.0, "max": 100.0 }
  ],
  "resources": [
    {
      "name": "velocity_tile_max",
      "lifetime": "transient",
      "format": "rgba16_float",
      "resolution": "quarter"
    },
    {
      "name": "velocity_neighbor_max",
      "lifetime": "transient",
      "format": "rgba16_float",
      "resolution": "quarter"
    },
    {
      "name": "directional_blur",
      "lifetime": "transient",
      "format": "rgba16_float",
      "resolution": "full"
    },
    {
      "name": "line_reconstruction",
      "lifetime": "transient",
      "format": "rgba16_float",
      "resolution": "full"
    },
    {
      "name": "line_blur_horizontal",
      "lifetime": "transient",
      "format": "rgba16_float",
      "resolution": "full"
    },
    {
      "name": "line_blur_vertical",
      "lifetime": "transient",
      "format": "rgba16_float",
      "resolution": "full"
    },
    {
      "name": "line_composite",
      "lifetime": "transient",
      "format": "rgba16_float",
      "resolution": "full"
    }
  ],
  "passes": [
    {
      "name": "velocity-tile-max",
      "shader": "effects/motion-blur/velocity-tile-max.hlsl",
      "vertexEntry": "VSMain",
      "pixelEntry": "PSTileMax",
      "reads": [
        { "slot": 1, "resource": "scene_depth" },
        { "slot": 2, "resource": "scene_velocity" }
      ],
      "output": "velocity_tile_max"
    },
    {
      "name": "velocity-neighbor-max",
      "shader": "effects/motion-blur/velocity-neighbor-max.hlsl",
      "vertexEntry": "VSMain",
      "pixelEntry": "PSNeighborMax",
      "reads": [
        { "slot": 0, "resource": "velocity_tile_max" }
      ],
      "output": "velocity_neighbor_max"
    },
    {
      "name": "directional-blur",
      "shader": "effects/motion-blur/directional-blur.hlsl",
      "vertexEntry": "VSMain",
      "pixelEntry": "PSDirectionalFirst",
      "reads": [
        { "slot": 0, "resource": "effect_input" },
        { "slot": 1, "resource": "scene_depth" },
        { "slot": 2, "resource": "scene_velocity" },
        { "slot": 3, "resource": "velocity_neighbor_max" }
      ],
      "output": "directional_blur"
    },
    {
      "name": "line-reconstruction",
      "shader": "effects/motion-blur/line-reconstruction.hlsl",
      "vertexEntry": "VSMain",
      "pixelEntry": "PSLineReconstruction",
      "reads": [
        { "slot": 0, "resource": "directional_blur" },
        { "slot": 1, "resource": "scene_depth" },
        { "slot": 2, "resource": "scene_velocity" },
        { "slot": 3, "resource": "velocity_neighbor_max" }
      ],
      "output": "line_reconstruction"
    },
    {
      "name": "line-blur-horizontal",
      "shader": "effects/motion-blur/line-gaussian.hlsl",
      "vertexEntry": "VSMain",
      "pixelEntry": "PSHorizontal",
      "reads": [
        { "slot": 0, "resource": "line_reconstruction" }
      ],
      "output": "line_blur_horizontal"
    },
    {
      "name": "line-blur-vertical",
      "shader": "effects/motion-blur/line-gaussian.hlsl",
      "vertexEntry": "VSMain",
      "pixelEntry": "PSVertical",
      "reads": [
        { "slot": 0, "resource": "line_blur_horizontal" }
      ],
      "output": "line_blur_vertical"
    },
    {
      "name": "line-composite",
      "shader": "effects/motion-blur/line-composite.hlsl",
      "vertexEntry": "VSMain",
      "pixelEntry": "PSLineComposite",
      "reads": [
        { "slot": 0, "resource": "directional_blur" },
        { "slot": 1, "resource": "line_blur_vertical" }
      ],
      "output": "line_composite"
    },
    {
      "name": "directional-refine",
      "shader": "effects/motion-blur/directional-blur.hlsl",
      "vertexEntry": "VSMain",
      "pixelEntry": "PSDirectionalFinal",
      "reads": [
        { "slot": 0, "resource": "line_composite" },
        { "slot": 1, "resource": "scene_depth" },
        { "slot": 2, "resource": "scene_velocity" },
        { "slot": 3, "resource": "velocity_neighbor_max" }
      ],
      "output": "effect_output"
    }
  ]
}
