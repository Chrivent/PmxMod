{
  "schemaVersion": 1,
  "id": "depth-of-field",
  "name": "Depth of Field",
  "type": "post_process",
  "requiresDepth": true,
  "historyPass": {
    "name": "focus-update",
    "shader": "effects/depth-of-field/focus-update.hlsl",
    "vertexEntry": "VSMain",
    "pixelEntry": "PSMain"
  },
  "passes": [
    {
      "name": "coc-prefilter",
      "shader": "effects/depth-of-field/coc-prefilter.hlsl",
      "vertexEntry": "VSMain",
      "pixelEntry": "PSMain",
      "resolution": "half"
    },
    {
      "name": "coc-downsample",
      "shader": "effects/depth-of-field/coc-downsample.hlsl",
      "vertexEntry": "VSMain",
      "pixelEntry": "PSMain",
      "resolution": "quarter"
    },
    {
      "name": "bokeh-blur-quarter",
      "shader": "effects/depth-of-field/bokeh-blur.hlsl",
      "vertexEntry": "VSMain",
      "pixelEntry": "PSMain",
      "resolution": "quarter"
    },
    {
      "name": "bokeh-refine-half",
      "shader": "effects/depth-of-field/bokeh-refine.hlsl",
      "vertexEntry": "VSMain",
      "pixelEntry": "PSMain",
      "resolution": "half"
    },
    {
      "name": "composite",
      "shader": "effects/depth-of-field/effect.hlsl",
      "vertexEntry": "VSMain",
      "pixelEntry": "PSMain",
      "resolution": "full"
    }
  ]
}
