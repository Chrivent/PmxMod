{
  "schemaVersion": 1,
  "id": "depth-debug",
  "name": "Depth Debug",
  "type": "post_process",
  "inputs": ["scene_depth"],
  "passes": [
    {
      "name": "main",
      "shader": "effects/depth-debug/effect.hlsl",
      "vertexEntry": "VSMain",
      "pixelEntry": "PSMain",
      "reads": [
        { "slot": 0, "resource": "effect_input" },
        { "slot": 1, "resource": "scene_depth" }
      ],
      "output": "effect_output"
    }
  ]
}
